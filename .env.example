# Public site URL used for canonical links, Open Graph and the sitemap.
VITE_SITE_URL=https://www.artsstory.tech

# Social profile links shown in the footer and mobile menu (leave empty to hide).
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_YOUTUBE=

# Server-only: JSON webhook that receives contact / DMCA / newsletter submissions
# (Slack or Discord incoming webhook, Zapier / Make catch hook, Formspree, …).
# Without it, forms return "temporarily unavailable" in production.
FORM_WEBHOOK_URL=
